{
  "expo": {
    "name": "Stop Motion Studio",
    "slug": "stopmotion-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.example.stopmotion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.example.stopmotion"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird benötigt, um Einzelbilder für deine Stop-Motion-Filme aufzunehmen.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Der Zugriff auf deine Fotos wird benötigt, um Bilder zu importieren.",
          "savePhotosPermission": "Wird benötigt, um fertige Animationen in deiner Galerie zu speichern.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-image"
    ],
    "scheme": "stopmotion"
  }
}
